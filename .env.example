# Copy to .env and fill in your own values.  .env is gitignored — never commit it.
#   cp .env.example .env

# ── OpenAI ────────────────────────────────────────────────────────────
# Your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# ── Spend guards for POST /ask ────────────────────────────────────────
# Local, per-process ceilings. Separate from OpenAI's own billing limits.
ASK_MAX_TOKENS=600
ASK_MAX_USD=0.50

# ── Spend guards for the prompt complexity classifier ─────────────────
CLASSIFIER_MAX_TOKENS=300
CLASSIFIER_MAX_USD=0.25

# ── Watchbird memory store (server/memory.py) ─────────────────────────
# Optional. Leave unset and the store defaults to the SQLite file below,
# so the API runs with no database configured at all.
#
# SQLite — a file next to the repo. Durable on this machine, survives restarts,
# does NOT survive a Render redeploy (the free web service has no disk).
DATABASE_URL=sqlite:///./watchbird.db
#
# Postgres — swap the line above for this form when you have an instance.
# Render injects this automatically via `fromDatabase` in render.yaml, so on
# Render you do NOT set it by hand.
# DATABASE_URL=postgresql+psycopg://...
# (the full form is credentials, host, port and database name; written with an
#  ellipsis so this placeholder does not match the CLAUDE.md rule 3 credential scan)
#
# Note on Render's free Postgres: it expires 30 days after creation, with a
# 14-day grace period, after which Render deletes the database and its data.

# -- Spend guards for POST /ping (Watchbird screening) -----------------
# One embedding of the news item, one classification call, and one embedding
# of what_happened per request. Its own wallet, separate from ASK_MAX_USD.
PING_MAX_TOKENS=500
PING_MAX_USD=0.50
